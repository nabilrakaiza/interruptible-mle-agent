# Copy to .env and fill in. .env is gitignored; never commit keys.

# LLM access (src/imle/llm.py). llm.provider in configs/base.yaml picks which one is used.
OPENROUTER_API_KEY=          # experiments (llm.provider: openrouter)
GEMINI_API_KEY=              # cheap local tests (llm.provider: gemini, or scripts/smoke_run.py --provider gemini)

# Model override. Empty: the provider's default (deepseek/deepseek-v4-flash-0731 on OpenRouter).
# For free tests: nvidia/nemotron-3-ultra-550b-a55b:free (also review llm.routing in configs/base.yaml).
LLM_MODEL=

# Where MLE-bench prepared the datasets. Empty: MLE-bench's default cache folder.
MLEBENCH_DATA_DIR=

# MLE-bench's own Python (it lives in a separate venv), used by scripts/grade.py.
MLEBENCH_PYTHON=
